{
  "manifest_version": 3,
  "name": "All Actions for GitHub",
  "short_name": "All Actions",
  "version": "0.9.0",
  "description": "An account-wide \"All actions\" view: see whether every repo's scheduled workflows ran and passed, on one page.",
  "homepage_url": "https://github.com/amorphose/All-Actions-for-GitHub",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "All actions",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/login/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/early.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/view.js",
        "src/view.css",
        "src/lib/runs.js",
        "src/lib/cron.js"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "src/settings.html",
    "open_in_tab": true
  },
  "optional_permissions": [
    "notifications"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "all-actions-for-github@amorphose",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
